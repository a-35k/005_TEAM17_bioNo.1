def load_csv(uploaded_file):
    encodings = ["utf-8", "utf-8-sig", "cp949"]
    for enc in encodings:
        try:
            uploaded_file.seek(0)
            return pd.read_csv(uploaded_file, encoding=enc)
        except Exception:
            continue
    return None

def get_value_column(df):
    if "수입금액" in df.columns:
        return "수입금액"
    if "수입중량" in df.columns:
        return "수입중량"
    return None

def validate_columns(df):
    value_col = get_value_column(df)
    required = ["품목", "국가"]
    for col in required:
        if col not in df.columns:
            return False, value_col
    if value_col is None:
        return False, value_col
    return True, value_col

def get_top5_by_food(df, food, value_col):
    filtered = df[df["품목"] == food].copy()
    if filtered.empty:
        return pd.DataFrame()

    result = (
        filtered.groupby("국가", as_index=False)[value_col]
        .sum()
        .sort_values(by=value_col, ascending=False)
        .head(5)
        .reset_index(drop=True)
    )
    result["순위"] = result.index + 1
    total = result[value_col].sum()
    result["비중"] = (result[value_col] / total * 100).round(1) if total != 0 else 0
    return result

def format_number(x):
    try:
        return f"{int(x):,}"
    except Exception:
        return str(x)

def rank_card_style(rank):
    colors = {
        1: "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)",
        2: "linear-gradient(135deg, #64748b 0%, #475569 100%)",
        3: "linear-gradient(135deg, #fb923c 0%, #c2410c 100%)",
        4: "linear-gradient(135deg, #60a5fa 0%, #2563eb 100%)",
        5: "linear-gradient(135deg, #34d399 0%, #059669 100%)"
    }
    return colors.get(rank, "linear-gradient(135deg, #9ca3af 0%, #4b5563 100%)")

def value_to_red_color(value, min_value, max_value):
    if max_value == min_value:
        red = 220
        green_blue = 90
    else:
        ratio = (value - min_value) / (max_value - min_value)
        red = int(180 + ratio * 75)
        green_blue = int(190 - ratio * 150)
    return [red, green_blue, green_blue, 210]

def prepare_map_data(top5_df, value_col, food):
    rows = []
    if top5_df.empty:
        return pd.DataFrame()

    max_value = top5_df[value_col].max()
    min_value = top5_df[value_col].min()

    for _, row in top5_df.iterrows():
        country = row["국가"]
        if country in COUNTRY_COORDS:
            lat, lon = COUNTRY_COORDS[country]

            if max_value == min_value:
                radius = 300000
            else:
                ratio = (row[value_col] - min_value) / (max_value - min_value)
                radius = int(180000 + ratio * 420000)

            rows.append({
                "품목": food,
                "국가": country,
                "lat": lat,
                "lon": lon,
                "순위": int(row["순위"]),
                "값": format_number(row[value_col]),
                "비중": row["비중"],
                "radius": radius,
                "color": value_to_red_color(row[value_col], min_value, max_value)
            })

    return pd.DataFrame(rows)

def generate_insights(top5_df, food):
    if top5_df.empty:
        return []

    top_share = top5_df.iloc[0]["비중"]
    top2_share = round(top5_df.head(2)["비중"].sum(), 1)
    top3_share = round(top5_df.head(3)["비중"].sum(), 1)

    if top_share >= 50:
        concentration_text = f"{food} 수입은 1위 국가에 매우 강하게 집중되어 있습니다. 단일 국가 의존도가 큰 편입니다."
    elif top_share >= 35:
        concentration_text = f"{food} 수입은 1위 국가 중심 구조를 보입니다. 특정 상위 국가 의존 경향이 뚜렷합니다."
    else:
        concentration_text = f"{food} 수입은 비교적 분산된 구조를 보입니다. 단일 국가 독점 현상은 크지 않습니다."

    if top2_share >= 70:
        top2_text = f"상위 2개국 비중이 {top2_share}%로 매우 높습니다. 공급선 집중 관리가 중요해 보입니다."
    elif top2_share >= 55:
        top2_text = f"상위 2개국 비중이 {top2_share}%로 절반을 크게 넘습니다. 상위권 국가 영향력이 큽니다."
    else:
        top2_text = f"상위 2개국 비중이 {top2_share}%입니다. 비교적 다양한 수입선이 유지되고 있습니다."

    top_country = top5_df.iloc[0]["국가"]
    third_country = top5_df.iloc[2]["국가"] if len(top5_df) >= 3 else "-"
    diversity_text = f"1위는 {top_country}, 상위 3개국 누적 비중은 {top3_share}%입니다. {third_country}까지가 핵심 수입권으로 볼 수 있습니다."

    return [
        ("집중도 분석", concentration_text),
        ("상위권 영향력", top2_text),
        ("구조 해석", diversity_text)
    ]

