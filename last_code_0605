def main():
    show_header()

    st.markdown('<div class="glass-card">', unsafe_allow_html=True)
    uploaded_file = st.file_uploader("CSV 파일 업로드", type=["csv"])
    st.markdown('</div>', unsafe_allow_html=True)

    if uploaded_file is None:
        st.info("CSV 파일을 업로드하면 분석형 대시보드가 자동으로 생성됩니다.")
        return

    df = load_csv(uploaded_file)
    if df is None:
        st.error("CSV 파일을 읽지 못했습니다. utf-8 / utf-8-sig / cp949 인코딩을 확인해 주세요.")
        return

    valid, value_col = validate_columns(df)
    if not valid:
        st.error("필수 컬럼이 없습니다. '품목', '국가', 그리고 '수입금액' 또는 '수입중량' 컬럼이 필요합니다.")
        st.write("현재 컬럼:", list(df.columns))
        return

    show_raw_data(df)

    selected_food = show_food_buttons()
    show_selected_food(selected_food)

    if selected_food is None:
        st.info("분석할 품목을 선택해 주세요.")
        return

    top5_df = get_top5_by_food(df, selected_food, value_col)

    if top5_df.empty:
        st.warning("선택한 품목에 대한 데이터가 없습니다.")
        return

    show_kpis(top5_df, value_col)
    show_summary(top5_df, value_col, selected_food)
    show_insights(top5_df, selected_food)
    show_rank_cards(top5_df, value_col)

    left, right = st.columns([1.4, 1])
    with left:
        show_bar_chart_altair(top5_df, value_col)
    with right:
        show_donut_chart(top5_df)

    left2, right2 = st.columns([1.2, 1])
    with left2:
        show_table(top5_df, value_col)
    with right2:
        st.markdown('<div class="section-title">결과 다운로드</div>', unsafe_allow_html=True)
        show_download(top5_df, selected_food)

    map_df = prepare_map_data(top5_df, value_col, selected_food)
    show_world_map(map_df)

if __name__ == "__main__":
    main()
