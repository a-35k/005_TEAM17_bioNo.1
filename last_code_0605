    show_df[value_col] = show_df[value_col].apply(format_number)
    show_df["비중"] = show_df["비중"].astype(str) + "%"

    st.dataframe(show_df, use_container_width=True, hide_index=True)

def show_download(top5_df, food):
    csv = top5_df.to_csv(index=False).encode("utf-8-sig")
    st.download_button(
        label=f"{food} TOP5 결과 CSV 다운로드",
        data=csv,
        file_name=f"{food}_top5_result.csv",
        mime="text/csv"
    )

def show_world_map(map_df):
    st.markdown('<div class="section-title">세계지도 시각화</div>', unsafe_allow_html=True)
    st.markdown("""
    <div class="map-note">
        원 크기가 클수록 수입 규모가 크며, 색이 진할수록 상대적으로 높은 수치를 의미합니다.
        마우스를 올리면 품목, 국가, 순위, 수입값, 비중을 확인할 수 있습니다.
    </div>
    """, unsafe_allow_html=True)

    if map_df.empty:
        st.warning("지도에 표시할 국가 좌표 데이터가 없습니다.")
        return

    layer = pdk.Layer(
        "ScatterplotLayer",
        data=map_df,
        get_position="[lon, lat]",
        get_fill_color="color",
        get_radius="radius",
        pickable=True,
        opacity=0.82,
        stroked=True,
        get_line_color=[120, 0, 0, 180],
        line_width_min_pixels=1
    )

    view_state = pdk.ViewState(
        latitude=18,
        longitude=10,
        zoom=1.1,
        min_zoom=1,
        max_zoom=10
    )

    tooltip = {
        "html": """
        <div style="padding:8px 10px;">
            <b>품목:</b> {품목}<br/>
            <b>국가:</b> {국가}<br/>
            <b>순위:</b> {순위}위<br/>
            <b>수입값:</b> {값}<br/>
            <b>비중:</b> {비중}%
        </div>
        """,
        "style": {
            "backgroundColor": "rgba(15, 23, 42, 0.95)",
            "color": "white",
            "borderRadius": "10px",
            "fontSize": "13px"
        }
    }

    deck = pdk.Deck(
        layers=[layer],
        initial_view_state=view_state,
        tooltip=tooltip,
        map_style="light"
    )

    st.pydeck_chart(deck, use_container_width=True)

